<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="spots_list" model="ir.ui.view">
        <field name="name">Spots</field>
        <field name="model">sd_seismology.spots</field>
            <field name="arch" type="xml">
                <list >
                    <header>
<!--                        <button name="create_kml" string=".kml" type="object" class="btn btn-primary"></button>-->
                    </header>
                    <field name="name"/>
                    <field name="project_name"/>
                    <field name="line"/>
                    <field name="latitude"/>
                    <field name="longitude"/>
                    <field name="date_plane"/>
                    <field name="state" widget="badge"
                                decoration-danger="state == 'stop'"
                                decoration-info="state == 'ongoing'"
                                decoration-success="state == 'done'"/>
                </list>
            </field>
    </record>

    <record id="spots_form" model="ir.ui.view">
        <field name="name">Spots</field>
        <field name="model">sd_seismology.spots</field>
            <field name="arch" type="xml">
                <form >
                    <header>
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="project_name"/>
                                <field name="line"/>
                                <field name="latitude"/>
                                <field name="longitude"/>
                                <field name="date_plane"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
    </record>

    <record id="spots_search" model="ir.ui.view">
        <field name="name">Spots</field>
        <field name="model">sd_seismology.spots</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="project_name"/>
                    <field name="latitude"/>
                    <field name="longitude"/>
                    <field name="date_plane"/>
                    <field name="state"/>
                    <filter name="projects" string="Projects" context="{'group_by': 'project_name'}"/>
                    <filter name="states" string="States" context="{'group_by': 'state'}"/>
                </search>
            </field>
    </record>

    <record id="spots_act_window" model="ir.actions.act_window">
        <field name="name">Spots</field>
        <field name="res_model">sd_seismology.spots</field>
        <field name="view_mode">list,form</field>
<!--        <field name="domain">[('project_name.record_editors', '=', uid),]</field>-->
        <field name="context">{'search_default_projects': 1, 'search_default_states': 1,}</field>
    </record>

    <record id="seismology_panel" model="ir.actions.client">
        <field name="name">Seismology Main Panel</field>
<!--        <field name="res_model">sd_seismology.records</field>-->
        <field name="tag">sd_seismology.main_panel</field>
    </record>

    <menuitem
        name="Seismology"
        id="seismology_root_menu"
        groups="sd_seismology.group_sd_seismology_users"
        action="seismology_panel"/>

    <menuitem
        name="Spots"
        id="spots_menu"
        parent="seismology_root_menu"
        groups="sd_seismology.group_sd_seismology_users"
        action="spots_act_window"/>

    <menuitem
        name="Configurations"
        id="configurations_root_menu"
        groups="sd_seismology.group_sd_seismology_admins"
        sequence="100"
        parent="seismology_root_menu"/>

    <menuitem
        name="Reports"
        id="report_menu"
        sequence="100"
        parent="seismology_root_menu"/>

</odoo>