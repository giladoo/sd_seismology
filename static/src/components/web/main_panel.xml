<?xml version="1.0" encoding="UTF-8" ?>
<template xml:space="preserve">

    <t t-name="sd_seismology.seismology_panel_template" owl="1">
        <div class="vh-100 overflow-auto">
        <div class="container1 h-100 my-4 px-1 ">
                    <div class="row row-cols-auto">
                        <div class="col-12 col-md-8 ">
                            <div class="row mx-0 bg-700 text-white text-center p-0 mb-2 rounded btn-group1">
                                <div class="col-4 px-1 py-2">Project Name</div>
                                <div class="col px-1 py-2 ">Spots</div>
                                <div class="col px-1 py-2 ">Planed</div>
                                <div class="col px-1 py-2 ">Ongoing</div>
                                <div class="col px-1 py-2 ">Stop</div>
                                <div class="col px-1 py-2 ">Done</div>
                            </div>
                            <div t-foreach="this.state.projects" t-as="project" t-key="project.id"
                                 class="row mx-0 px-2 py-0 mb-1 border ">
                                <div class="col-4">
                                    <div t-if="project.id" class="btn btn-link  " t-esc="project.name"  t-on-click="() => this.selectProject(project.id)"></div>
                                    <div t-else="" class=" " t-esc="project.name" ></div>
                                </div>
                                    <div class="col px-1 py-2 text-center  " t-esc="project.spots"></div>
                                    <div class="col px-1 py-2 text-center  " t-esc="project.states.planed"></div>
                                    <div class="col px-1 py-2 text-center  " t-esc="project.states.ongoing"></div>
                                    <div class="col px-1 py-2 text-center  " t-esc="project.states.stop"></div>
                                    <div class="col px-1 py-2 text-center  " t-esc="project.states.done"></div>


                        </div>
                    </div>
                    </div>
            </div>
        </div>
    </t>

    <t t-name="sd_seismology.seismology_panel_template_1" owl="1">
        <div class="vh-100 overflow-auto">
            <div class="container1 h-100 my-4 px-1 ">
                <div t-ref="project_name_list_ref" class="row row-cols-auto mx-0 px-0">

                    <Dropdown menuClass="'btn btn-secondary m-0 px-2 py-1'">
                        <button class="btn btn-primary col-3 text-center" type="button">
                            <div class="row row-cols-auto justify-content-center">
                                <div class="" t-ref="selected_project"/>
                                <i class="fa fa-caret-down align-content-around"/>
                            </div>
                        </button>
                        <t t-foreach="this.state.project_names" t-as="project" t-key="project.id" t-set-slot="content">
                            <DropdownItem onSelected="() => this.selectProject(project)">
                                <t t-esc="project.name"/>
                            </DropdownItem>
                        </t>
                    </Dropdown>

                    <t t-if="this.state.selectedProject.id != 0">
                        <t t-foreach="this.state.need_action" t-as="rec" t-key="rec.id">
                            <t t-if="rec.id == this.state.selectedProject.id">
                                <t t-set="list_count" t-value="rec.list"></t>
                                <t t-set="stop_card_count" t-value="rec.stop_card"></t>
                                <t t-set="open_count" t-value="rec.open"></t>
                            </t>
                        </t>
                        <div class="row row-cols-auto mx-4">
                        <div class="col">
                            <button class="btn btn-outline-primary"
                                    t-on-click="() => this.onDailyReport('report', this.state.selectedProject.id)"
                                    t-ref="daily_report_box">Daily Reports <span t-if="list_count" t-esc="list_count"
                                                                                 class="badge bg-danger-light"></span> </button>
                        </div>
                            <div class="col">
                            <button class="btn btn-outline-primary"
                                    t-on-click="() => this.onDailyReport('stop_card', this.state.selectedProject.id)"
                                    t-ref="stop_card_box">Stop Card <span t-if="stop_card_count" t-esc="stop_card_count"
                                                                          class="badge bg-danger-light"></span> </button>
                        </div>
                            <div class="col">
                            <button class="btn btn-outline-primary"
                                    t-on-click="() => this.onDailyReport('actions', this.state.selectedProject.id)"
                                    t-ref="action_list_box">Open Action List <span t-if="open_count" t-esc="open_count"
                                                                                   class="badge bg-danger-light"></span> </button>
                        </div>
                            <div class="col">
                            <button class="btn btn-outline-primary"
                                    t-ref="action_list_box">PTW <span t-if="0" t-esc="open_count"
                                                                      class="badge bg-danger-light"></span> </button>
                        </div>
                            <div class="col">
                            <button class="btn btn-outline-primary"
                                    t-ref="action_list_box">Training <span t-if="0" t-esc="open_count"
                                                                           class="badge bg-danger-light"></span> </button>
                        </div>
                    </div>
                </t>
                                    </div>

                <div class="border my-3"></div>

                <div t-if="this.state.selectedProject.id == 0">
                    <div class="row row-cols-auto">
                        <div class="col-12 col-md-8 ">
                            <div class="row mx-0 bg-700 text-white text-center p-0 mb-2 rounded btn-group1"
                                 t-on-click="e => this.selectKpi(e)">
                                <div class="col-4">Project Name</div>
                                <div class="col px-1 py-2  ">Daily</div>
                                <div class="col px-1 py-2  ">STOP</div>
                                <div class="col px-1 py-2  ">Activity</div>
                                <div id="far" class="col px-1 py-2  border-gray  btn btn-outline-light">FAR</div>
                                <div id="fr" class="col px-1 py-2  border-gray  btn btn-outline-light">FR</div>
                                <div id="sa" class="col px-1 py-2  border-gray  btn btn-outline-light">SA</div>
                                <div id="sr" class="col px-1 py-2  border-gray  btn btn-outline-light">SR</div>
                                <div id="trir" class="col px-1 py-2  border-gray  btn btn-outline-light">TRIR</div>
                                <div id="fsi" class="col px-1 py-2  border-gray  btn btn-outline-light">FSI</div>
                                <div id="ltif" class="col px-1 py-2  border-gray  btn btn-light">LTIF</div>
                            </div>
                            <div t-foreach="this.state.need_action" t-as="need_action" t-key="need_action.name"
                                 class="row mx-0 px-2 py-1 mb-1  ">
                                <div class="col-4">
                                    <div t-if="need_action.id" class="btn btn-link " t-esc="need_action.name"
                                         t-on-click="() => this.selectProject(need_action)"></div>
                                    <div t-else="" class=" " t-esc="need_action.name"></div>
                                </div>
                                <div class="col px-0   text-center">
                                    <div t-if="need_action.id" class="btn btn-outline-primary  -danger"
                                         t-esc="need_action.list"
                                         t-on-click="() => this.onDailyReport('report', need_action.id)"></div>

                                </div>
                                <div class="col px-0   text-center">
                                    <div t-if="need_action.id" class="btn btn-outline-primary"
                                         t-esc="need_action.stop_card"
                                         t-on-click="() => this.onDailyReport('stop_card', need_action.id)"></div>

                                </div>
                                <div class="col px-0   text-center">
                                    <div t-if="need_action.id" class="btn btn-outline-primary" t-esc="need_action.open"
                                         t-on-click="() => this.onDailyReport('actions', need_action.id)"></div>
                                </div>
                                <div class="col px-0   text-center">
                                    <div class=""
                                         t-esc="this.state.kpis[need_action.id] and this.state.kpis[need_action.id].far"></div>
                                </div>
                                <div class="col px-0   text-center">
                                    <div class=""
                                         t-esc="this.state.kpis[need_action.id] and this.state.kpis[need_action.id].fr"></div>
                                </div>
                                <div class="col px-0   text-center">
                                    <div class=""
                                         t-esc="this.state.kpis[need_action.id] and this.state.kpis[need_action.id].sa"></div>
                                </div>
                                <div class="col px-0   text-center">
                                    <div class=""
                                         t-esc="this.state.kpis[need_action.id] and this.state.kpis[need_action.id].sr"></div>
                                </div>
                                <div class="col px-0   text-center">
                                    <div class=""
                                         t-esc="this.state.kpis[need_action.id] and this.state.kpis[need_action.id].trir"></div>
                                </div>
                                <div class="col px-0   text-center">
                                    <div class=""
                                         t-esc="this.state.kpis[need_action.id] and this.state.kpis[need_action.id].fsi"></div>
                                </div>
                                <div class="col px-0   text-center">
                                    <div class=""
                                         t-esc="this.state.kpis[need_action.id] and this.state.kpis[need_action.id].ltif"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="col-6 h-0 mx-auto">
                                <canvas t-ref="canvas_all"/>

                            </div>
                        </div>
                    </div>


                    <div class=" mb-3"></div>
                    <div class="col-12 row  mx-0  justify-content-around">

<!--                        <t t-foreach="this.state.mainCharts" t-as="key" t-key="key">-->
                        <!--                            <t t-set="chart" t-value="this.state.mainCharts[key]"/>-->
                        <!--                            <ChartBox key="key" class="chart.class" name="chart.name" selected="chart.selected"-->
                        <!--                                      description="chart.description" config="chart.config" onClick="chart.onClick"/>-->
                        <!--                        </t>-->

                    </div>
                </div>


                <t t-if="this.state.selectedProject.id != 0">
                    <div class="col-12 row mx-0 justify-content-around">
                        <div class="col-12 col-md-6 mb-5 h-0">
                            <canvas t-ref="canvas"/>
                        </div>
                    </div>
                </t>







            </div>
        </div>
    </t>
</template>