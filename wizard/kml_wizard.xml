<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="panel_wizard" model="ir.ui.view">
        <field name="name">HR Panel</field>
        <field name="model">sd_seismology.kml_wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="project_name"/>
<!--                            <field name="plot"/>-->
                            <field name="name_visible"/>
                            <field name="spot_visible"/>
                            <field name="radius"/>
                            <field name="vertices"/>
<!--                            <field name="color" widget="color_picker"/>-->

                        </group>
                    </group>
                    <footer>
                        <button name="create_kml" string="Download" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kml_wizard_action" model="ir.actions.act_window">
        <field name="name">KML Download</field>
        <field name="res_model">sd_seismology.kml_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>

    </record>

    <menuitem id="kml_wizard"
              name="KML"
              parent="sd_seismology.report_menu"
              sequence="2"
              action="kml_wizard_action"/>


</odoo>
